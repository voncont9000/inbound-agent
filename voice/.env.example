# Backend routing for tokenized assistant practice calls.
API_BASE_URL=http://127.0.0.1:8000
VOICE_SERVICE_TOKEN=dev-only-voice-service-token
# Required only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Required only when LLM_PROVIDER=google.
GOOGLE_API_KEY=
# Required only when STT_PROVIDER or TTS_PROVIDER is deepgram.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=
SPEECHIFY_API_KEY=
ELEVENLABS_API_KEY=
STT_PROVIDER=assemblyai
TTS_PROVIDER=speechify
# Suggested ElevenLabs voice: Katie X — Clear British Customer Support
# ID MzqUf1HbJ8UmQ0wUsx2p; built-in alternative Alice: Xb7hH8MSUJpSbSDYk0k2.
# v4 Turbo uses HTTP streaming (WebSocket rejects it with HTTP 400); Flash v2.5 uses WebSocket.
TTS_VOICE=
ELEVENLABS_MODEL=eleven_v4_turbo
LLM_PROVIDER=google
# Defaults to gemini-3.5-flash-lite for Google or google/gemini-2.5-flash for OpenRouter.
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=minimal
# Assistant file; this demo extends the configurable UK law-firm template.
ASSISTANT_CONFIG=config/assistants/demo_firm.yaml
# Post-call intake extraction model; blank disables extraction.
EXTRACTION_MODEL=gemini-3.8-flash
# Silence seconds before Smart Turn fallback ends an incomplete turn.
SMART_TURN_STOP_SECS=0.7
# Extra silence after a likely incomplete UK phone number before starting the LLM.
NUMBER_HOLD_SECS=2.0
# Test-only caller ID override for local/evaluation WebRTC calls.
# CALLER_ID_OVERRIDE=07700900456
KNOWLEDGE_DIGEST_PATH=
# Seconds of caller silence after bot speech before the idle prompt and hang-up.
IDLE_PROMPT_SECS=8
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
