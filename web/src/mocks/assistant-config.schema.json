            "webhook": "#/$defs/WebhookAction"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/EmailCustomerAction"
          },
          {
            "$ref": "#/$defs/NotifyStaffAction"
          },
          {
            "$ref": "#/$defs/SheetsRowAction"
