{
  "$defs": {
    "AppointmentType": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "duration_minutes": {
          "exclusiveMinimum": 0,
          "maximum": 480,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "when_to_use": {
          "title": "When To Use",
          "type": "string"
        },
        "location_or_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Or Link"
        }
      },
      "required": [
        "key",
        "label",
        "duration_minutes",
        "when_to_use"
      ],
      "title": "AppointmentType",
      "type": "object"
    },
    "BookingConfig": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "default": "primary",
          "title": "Calendar Id",
          "type": "string"
        },
        "appointment_types": {
          "items": {
            "$ref": "#/$defs/AppointmentType"
          },
          "minItems": 1,
          "title": "Appointment Types",
          "type": "array"
        },
        "min_notice_hours": {
          "default": 2,
          "minimum": 0,
          "title": "Min Notice Hours",
          "type": "integer"
        },
        "horizon_days": {
          "default": 14,
          "maximum": 60,
          "minimum": 1,
          "title": "Horizon Days",
          "type": "integer"
        },
        "buffer_minutes": {
          "default": 0,
          "minimum": 0,
          "title": "Buffer Minutes",
          "type": "integer"
        },
        "max_slots_offered": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Slots Offered",
          "type": "integer"
        },
        "slot_step_minutes": {
          "default": 30,
          "maximum": 240,
          "minimum": 5,
          "title": "Slot Step Minutes",
          "type": "integer"
        },
        "send_updates": {
          "default": "all",
          "enum": [
            "all",
            "externalOnly",
            "none"
          ],
          "title": "Send Updates",
          "type": "string"
        },
        "check_message": {
          "default": "Let me check the diary.",
          "title": "Check Message",
          "type": "string"
        },
        "book_message": {
          "default": "One moment while I book that.",
          "title": "Book Message",
          "type": "string"
        }
      },
      "required": [
        "appointment_types"
      ],
      "title": "BookingConfig",
      "type": "object"
    },
    "DateDeadlineUrgencyRule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "date_deadline",
          "title": "Type",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "add_months": {
          "title": "Add Months",
          "type": "integer"
        },
        "minus_days": {
          "title": "Minus Days",
          "type": "integer"
        },
        "urgent_within_days": {
          "title": "Urgent Within Days",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "service",
        "field",
        "add_months",
        "minus_days",
        "urgent_within_days",
        "reason"
      ],
      "title": "DateDeadlineUrgencyRule",
      "type": "object"
    },
    "EmailCustomerAction": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/PostActionTrigger"
        },
        "kind": {
          "const": "email_customer",
          "title": "Kind",
          "type": "string"
        },
        "subject_template": {
          "minLength": 1,
          "title": "Subject Template",
          "type": "string"
        },
        "body_template": {
          "minLength": 1,
          "title": "Body Template",
          "type": "string"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "subject_template",
        "body_template"
      ],
      "title": "EmailCustomerAction",
      "type": "object"
    },
    "EmailTriageConfig": {
      "additionalProperties": false,
      "properties": {
        "enquiry": {
          "default": "A customer or prospective customer asking about the business's services, prices, availability or their own case, which you can answer or move forward from the business context.",
          "title": "Enquiry",
          "type": "string"
        },
        "needs_human": {
          "default": "A person must decide or act: complaints, disputes, threats or safety concerns, requests the business context does not cover, or anything you cannot answer without inventing facts.",
          "title": "Needs Human",
          "type": "string"
        },
        "spam": {
          "default": "Unsolicited marketing, phishing, scams or automated bulk mail.",
          "title": "Spam",
          "type": "string"
        },
        "not_relevant": {
          "default": "Genuine mail that needs no reply, such as a thank-you with no question, a delivery receipt, or a message clearly meant for a different business.",
          "title": "Not Relevant",
          "type": "string"
        }
      },
      "title": "EmailTriageConfig",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "email",
            "phone",
            "date",
            "boolean",
            "integer",
            "number",
            "enum",
            "list"
          ],
          "title": "Type",
          "type": "string"
        },
        "choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "KeywordUrgencyRule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "keyword",
          "title": "Type",
          "type": "string"
        },
        "phrases": {
          "items": {
            "type": "string"
          },
          "title": "Phrases",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "phrases",
        "reason"
      ],
      "title": "KeywordUrgencyRule",
      "type": "object"
    },
    "KnowledgeConfig": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "faqs": {
          "items": {
            "$ref": "#/$defs/KnowledgeFAQ"
          },
          "title": "Faqs",
          "type": "array"
        },
        "digest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest Path"
        },
        "max_digest_chars": {
          "default": 24000,
          "exclusiveMinimum": 0,
          "title": "Max Digest Chars",
          "type": "integer"
        },
        "digest_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest Content"
        }
      },
      "title": "KnowledgeConfig",
      "type": "object"
    },
    "KnowledgeFAQ": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "KnowledgeFAQ",
      "type": "object"
    },
    "KnowledgeSource": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        }
      },
      "title": "KnowledgeSource",
      "type": "object"
    },
    "NotifyStaffAction": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/PostActionTrigger"
        },
        "kind": {
          "const": "notify_staff",
          "title": "Kind",
          "type": "string"
        },
        "to": {
          "items": {
            "format": "email",
            "type": "string"
          },
          "minItems": 1,
          "title": "To",
          "type": "array"
        },
        "subject_template": {
          "minLength": 1,
          "title": "Subject Template",
          "type": "string"
        },
        "body_template": {
          "minLength": 1,
          "title": "Body Template",
          "type": "string"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "to",
        "subject_template",
        "body_template"
      ],
      "title": "NotifyStaffAction",
      "type": "object"
    },
    "OfficeHours": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "items": {
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "opens": {
          "title": "Opens",
          "type": "string"
        },
        "closes": {
          "title": "Closes",
          "type": "string"
        },
        "timezone": {
          "default": "Europe/London",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "days",
        "opens",
        "closes"
      ],
      "title": "OfficeHours",
      "type": "object"
