        },
        "value_template": {
          "title": "Value Template",
          "type": "string"
        }
      },
      "required": [
        "header",
        "value_template"
      ],
      "title": "SheetColumn",
      "type": "object"
    },
    "SheetsRowAction": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "enabled": {
          "default": true,
