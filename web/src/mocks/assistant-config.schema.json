{
  "$defs": {
    "DateDeadlineUrgencyRule": {
      "additionalProperties": false,
      "properties": {
        "add_months": {
          "title": "Add Months",
          "type": "integer"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "minus_days": {
          "title": "Minus Days",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        },
        "type": {
          "const": "date_deadline",
          "title": "Type",
          "type": "string"
        },
        "urgent_within_days": {
          "title": "Urgent Within Days",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "service",
        "field",
        "add_months",
        "minus_days",
        "urgent_within_days",
        "reason"
      ],
      "title": "DateDeadlineUrgencyRule",
      "type": "object"
    },
    "EmailCustomerAction": {
      "additionalProperties": false,
      "properties": {
        "body_template": {
          "minLength": 1,
          "title": "Body Template",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "email_customer",
          "title": "Kind",
          "type": "string"
        },
        "subject_template": {
          "minLength": 1,
          "title": "Subject Template",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/PostActionTrigger"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "subject_template",
        "body_template"
      ],
      "title": "EmailCustomerAction",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Choices"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "email",
            "phone",
            "date",
            "boolean",
            "integer",
            "number",
            "enum",
            "list"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "KeywordUrgencyRule": {
      "additionalProperties": false,
      "properties": {
        "phrases": {
          "items": {
            "type": "string"
          },
          "title": "Phrases",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "keyword",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "phrases",
        "reason"
      ],
      "title": "KeywordUrgencyRule",
      "type": "object"
    },
    "KnowledgeConfig": {
      "additionalProperties": false,
      "properties": {
        "digest_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest Content"
        },
        "digest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest Path"
        },
        "faqs": {
          "items": {
            "$ref": "#/$defs/KnowledgeFAQ"
          },
          "title": "Faqs",
          "type": "array"
        },
        "max_digest_chars": {
          "default": 24000,
          "exclusiveMinimum": 0,
          "title": "Max Digest Chars",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeSource"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "KnowledgeConfig",
      "type": "object"
    },
    "KnowledgeFAQ": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "KnowledgeFAQ",
      "type": "object"
    },
    "KnowledgeSource": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "KnowledgeSource",
      "type": "object"
    },
    "NotifyStaffAction": {
      "additionalProperties": false,
      "properties": {
        "body_template": {
          "minLength": 1,
          "title": "Body Template",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "notify_staff",
          "title": "Kind",
          "type": "string"
        },
        "subject_template": {
          "minLength": 1,
          "title": "Subject Template",
          "type": "string"
        },
        "to": {
          "items": {
            "format": "email",
            "type": "string"
          },
          "minItems": 1,
          "title": "To",
          "type": "array"
        },
        "trigger": {
          "$ref": "#/$defs/PostActionTrigger"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "to",
        "subject_template",
        "body_template"
      ],
      "title": "NotifyStaffAction",
      "type": "object"
    },
    "OfficeHours": {
      "additionalProperties": false,
      "properties": {
        "closes": {
          "title": "Closes",
          "type": "string"
        },
        "days": {
          "items": {
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "opens": {
          "title": "Opens",
          "type": "string"
        },
        "timezone": {
          "default": "Europe/London",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "days",
        "opens",
        "closes"
      ],
      "title": "OfficeHours",
      "type": "object"
    },
    "PostActionTrigger": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "enum": [
              "phone",
              "web",
              "gmail",
              "whatsapp"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "events": {
          "items": {
            "enum": [
              "conversation_completed",
              "urgent",
              "callback_requested",
              "needs_human",
              "complaint"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "PostActionTrigger",
      "type": "object"
    },
    "PriceItem": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "price",
        "notes"
      ],
      "title": "PriceItem",
      "type": "object"
    },
    "ServiceConfig": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "title": "Fields",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "fields"
      ],
      "title": "ServiceConfig",
      "type": "object"
    },
    "SheetColumn": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "minLength": 1,
          "title": "Header",
          "type": "string"
        },
        "value_template": {
          "title": "Value Template",
          "type": "string"
        }
      },
      "required": [
        "header",
        "value_template"
      ],
      "title": "SheetColumn",
      "type": "object"
    },
    "SheetsRowAction": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/SheetColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "sheets_row",
          "title": "Kind",
          "type": "string"
        },
        "sheet_name": {
          "default": "Sheet1",
          "minLength": 1,
          "title": "Sheet Name",
          "type": "string"
        },
        "spreadsheet_id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Spreadsheet Id",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/PostActionTrigger"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "spreadsheet_id",
        "columns"
      ],
      "title": "SheetsRowAction",
      "type": "object"
    },
    "WebhookAction": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "webhook",
          "title": "Kind",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/PostActionTrigger"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "url"
      ],
      "title": "WebhookAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "business_name": {
      "title": "Business Name",
      "type": "string"
    },
    "contacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Contacts",
      "type": "object"
    },
    "greeting": {
      "title": "Greeting",
      "type": "string"
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "knowledge": {
      "$ref": "#/$defs/KnowledgeConfig"
    },
    "language": {
      "default": "English",
      "title": "Language",
      "type": "string"
    },
    "live_actions": {
      "items": {
        "enum": [
          "confirm_critical_fields",
          "flag_urgent",
          "request_callback",
          "log_complaint",
          "end_call"
        ],
        "type": "string"
      },
      "title": "Live Actions",
      "type": "array"
    },
    "office_hours": {
      "$ref": "#/$defs/OfficeHours"
    },
    "policies": {
      "items": {
        "type": "string"
      },
      "title": "Policies",
      "type": "array"
    },
    "post_actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "email_customer": "#/$defs/EmailCustomerAction",
            "notify_staff": "#/$defs/NotifyStaffAction",
            "sheets_row": "#/$defs/SheetsRowAction",
            "webhook": "#/$defs/WebhookAction"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/EmailCustomerAction"
          },
          {
            "$ref": "#/$defs/NotifyStaffAction"
          },
          {
            "$ref": "#/$defs/SheetsRowAction"
          },
          {
            "$ref": "#/$defs/WebhookAction"
          }
        ]
      },
      "title": "Post Actions",
      "type": "array"
    },
    "price_list": {
      "items": {
        "$ref": "#/$defs/PriceItem"
      },
      "title": "Price List",
      "type": "array"
    },
    "readback": {
      "default": "off",
      "enum": [
        "off",
        "email",
        "critical"
      ],
      "title": "Readback",
      "type": "string"
    },
    "review_confidence_threshold": {
      "default": 0.7,
      "maximum": 1,
      "minimum": 0,
      "title": "Review Confidence Threshold",
      "type": "number"
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/ServiceConfig"
      },
      "title": "Services",
      "type": "object"
    },
    "urgency_rules": {
      "items": {
        "discriminator": {
          "mapping": {
            "date_deadline": "#/$defs/DateDeadlineUrgencyRule",
            "keyword": "#/$defs/KeywordUrgencyRule"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/KeywordUrgencyRule"
          },
          {
            "$ref": "#/$defs/DateDeadlineUrgencyRule"
          }
        ]
      },
      "title": "Urgency Rules",
      "type": "array"
    }
  },
  "required": [
    "business_name",
    "greeting",
    "office_hours",
    "price_list",
    "policies",
    "contacts",
    "services",
    "urgency_rules",
    "live_actions"
  ],
  "title": "AssistantConfig",
  "type": "object"
}
