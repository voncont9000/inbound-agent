    "PostActionTrigger": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "enum": [
              "conversation_completed",
              "urgent",
              "callback_requested",
              "needs_human",
              "complaint"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "channels": {
          "items": {
            "enum": [
              "phone",
              "web",
              "gmail",
              "whatsapp"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "events"
      ],
      "title": "PostActionTrigger",
      "type": "object"
    },
    "PriceItem": {
      "additionalProperties": false,
      "properties": {
        "service": {
          "title": "Service",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "string"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "service",
        "price",
        "notes"
      ],
      "title": "PriceItem",
      "type": "object"
    },
    "PronunciationEntry": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "say_as": {
          "minLength": 1,
          "title": "Say As",
          "type": "string"
        }
      },
      "required": [
        "term",
        "say_as"
      ],
      "title": "PronunciationEntry",
      "type": "object"
    },
    "RulesConfig": {
      "additionalProperties": false,
      "properties": {
        "ai_disclosure": {
          "default": "at_start",
          "enum": [
            "at_start",
            "when_asked"
          ],
          "title": "Ai Disclosure",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "formal",
                "friendly",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "off_topic": {
          "anyOf": [
            {
              "enum": [
                "redirect",
                "answer_briefly"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Off Topic"
        },
        "angry_caller": {
          "anyOf": [
            {
              "const": "de_escalate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angry Caller"
        },
        "sales_calls": {
          "anyOf": [
            {
              "enum": [
                "decline",
                "take_message"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sales Calls"
        },
        "pronunciations": {
          "items": {
            "$ref": "#/$defs/PronunciationEntry"
          },
          "title": "Pronunciations",
          "type": "array"
        }
      },
      "title": "RulesConfig",
      "type": "object"
    },
    "SentenceUrgencyRule": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sentence",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "SentenceUrgencyRule",
      "type": "object"
    },
    "ServiceConfig": {
