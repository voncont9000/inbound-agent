        "sheet_name": {
          "default": "Sheet1",
          "minLength": 1,
          "title": "Sheet Name",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/SheetColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "key",
        "trigger",
        "kind",
        "spreadsheet_id",
        "columns"
      ],
      "title": "SheetsRowAction",
      "type": "object"
    },
    "TransferTarget": {
