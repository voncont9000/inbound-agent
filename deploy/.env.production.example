# Runtime environment
APP_ENV=production
DOMAIN=agent.vinci-labs.tech
ACME_EMAIL=you@example.com

# Required database credentials; generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
INBOUND_APP_PASSWORD=replace-with-openssl-rand-hex-32

# Required shared service token; generate with: openssl rand -hex 32
VOICE_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

# WhatsApp is disabled until configured. Use graph only after all credentials are set.
WHATSAPP_MODE=off
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v26.0

# Keep Gmail disabled until OAuth, Pub/Sub, and credential encryption are configured.
GMAIL_MODE=off
# off | google (google requires GMAIL_MODE=google; fake is refused in production)
CALENDAR_MODE=off
GMAIL_FAKE_DIR=/app/backend/var/gmail-fake
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://agent.vinci-labs.tech/oauth/google/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUSH_TOKEN=
GMAIL_RECONCILE_INTERVAL_SECONDS=300
CREDENTIALS_ENCRYPTION_KEY=

# Post-conversation actions are disabled until their providers are configured.
EMAIL_SENDER=off
RESEND_API_KEY=
EMAIL_FROM=
SHEETS_WRITER=off
WEBHOOK_SENDER=off
POST_ACTIONS_FAKE_DIR=/app/backend/var/post-actions
POST_ACTION_WEBHOOK_ALLOW_PRIVATE_URLS=false
APP_BASE_URL=https://agent.vinci-labs.tech

# Twilio is disabled until credentials and the production webhook are configured.
TWILIO_MODE=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional production demo-call token; generate with: openssl rand -hex 32
WEB_CALL_TOKEN=
WEB_CALL_MAX_CONCURRENT=2
WEB_CALL_TO_NUMBER=

# Voice and model providers; set credentials only for the selected providers.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SONIOX_API_KEY=
SPEECHIFY_API_KEY=
ELEVENLABS_API_KEY=
TTS_VOICE=
ELEVENLABS_MODEL=eleven_v4_turbo
STT_PROVIDER=assemblyai
TTS_PROVIDER=speechify
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=minimal
ASSISTANT_CONFIG=config/assistants/demo_firm.yaml
TEXT_AGENT_MODEL=gemini-3.5-flash-lite
EXTRACTION_MODEL=gemini-3.8-flash
KNOWLEDGE_MODEL=gemini-3.8-flash
SETUP_DRAFT_MODEL=gemini-3.1-flash-lite
SETUP_DRAFT_MAX_PAGES=10
SMART_TURN_STOP_SECS=1.5
NUMBER_HOLD_SECS=2.0
KNOWLEDGE_DIGEST_PATH=
IDLE_PROMPT_SECS=8
RECORDING_MAX_BYTES=209715200

# Tracing (optional, Langfuse EU)
# OTEL_EXPORTER_OTLP_ENDPOINT: https://cloud.langfuse.com/api/public/otel
# LANGFUSE_HOST: https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Backup destination and optional Restic/S3-compatible storage.
BACKUP_DIR=/var/backups/inbound
BACKUP_WEEKLY=0
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
