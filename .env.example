# Local-only development settings. Replace these before using a non-local environment.
POSTGRES_USER=inbound_migrator
POSTGRES_PASSWORD=inbound_migrator
POSTGRES_DB=inbound
APP_ENV=development
DATABASE_URL=postgresql+psycopg://inbound_app_login:inbound_dev_only@localhost:5432/inbound
APP_DATABASE_URL=postgresql://inbound_app_login:inbound_dev_only@localhost:5432/inbound
VOICE_SERVICE_TOKEN=dev-only-voice-service-token
WEB_CALL_BASE_URL=http://127.0.0.1:7862/
GOOGLE_API_KEY=
# fake for local simulation; graph for Meta Cloud API; off disables the channel.
WHATSAPP_MODE=fake
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v26.0
TEXT_AGENT_MODEL=gemini-3.5-flash-lite
EXTRACTION_MODEL=gemini-3.8-flash
MESSAGE_EXTRACT_DELAY_SECONDS=120
FAKE_OUTBOX_PATH=backend/var/whatsapp-outbox.jsonl
# Set to off until Google OAuth/Pub/Sub configuration is available in production.
GMAIL_MODE=fake
GMAIL_FAKE_DIR=backend/var/gmail-fake
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/oauth/google/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUSH_TOKEN=
GMAIL_RECONCILE_INTERVAL_SECONDS=300
# Calendar uses the shared Google OAuth connection; fake is for local development only.
CALENDAR_MODE=fake
CALENDAR_FAKE_PATH=backend/var/calendar-fake.json
CALENDAR_FAKE_DELAY_MS=0
CREDENTIALS_ENCRYPTION_KEY=
UPLOAD_DIR=backend/var/uploads
# Set false for local HTTP development; enable for HTTPS deployments.
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]
